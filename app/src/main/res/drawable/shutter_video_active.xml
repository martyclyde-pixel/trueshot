<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="@color/chrome" />
            <size android:width="72dp" android:height="72dp" />
        </shape>
    </item>
    <!-- Stop square, matching the stock camera's recording affordance. -->
    <item android:top="22dp" android:bottom="22dp" android:left="22dp" android:right="22dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/record_fill" />
        </shape>
    </item>
</layer-list>
